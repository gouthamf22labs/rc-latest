FROM public.ecr.aws/docker/library/node:24-bookworm-slim AS base

# bookworm, not bullseye: bullseye-security stopped publishing and its package pool was
# withdrawn from deb.debian.org, so apt 404s on ffmpeg's dependencies. Ignoring the
# expired Release file is not enough - the .debs are simply gone.
# Building needs only git (for git dependencies); ffmpeg is a runtime need, installed in the
# production stage. The apt and npm caches persist between builds (BuildKit cache mounts), so a
# rebuild downloads only what changed.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update && apt-get install -y --no-install-recommends git

WORKDIR /codechat

COPY package*.json .npmrc ./

# postinstall runs patch-package; with no patches/ yet it does nothing. The patches are applied
# below, so editing one doesn't redo the whole install.
RUN --mount=type=cache,target=/root/.npm npm install --force

COPY ./patches ./patches
RUN npx patch-package

COPY tsconfig.json .
COPY ./src ./src
COPY ./public ./public
COPY ./docs ./docs
COPY ./prisma ./prisma
COPY ./views ./views
COPY .env.dev .env
COPY prisma.config.mjs .

RUN npx prisma generate

RUN npm run build

RUN npm prune --omit=dev --legacy-peer-deps

# sharp ships per-platform native binaries as optionalDependencies; a lockfile
# generated on macOS plus `npm install --force` can leave the linux binary out,
# so the app crashes at boot with "Could not load the sharp module". Reinstall it
# for the image's own architecture (works for both arm64 and amd64 builds).
RUN --mount=type=cache,target=/root/.npm npm install --include=optional --no-save --legacy-peer-deps sharp

FROM public.ecr.aws/docker/library/node:24-bookworm-slim AS production

# See the note in the base stage.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update && apt-get install -y --no-install-recommends ffmpeg

WORKDIR /codechat

COPY --from=base /codechat/dist ./dist
COPY --from=base /codechat/docs ./docs
COPY --from=base /codechat/prisma ./prisma
COPY --from=base /codechat/views ./views
COPY --from=base /codechat/node_modules ./node_modules
COPY --from=base /codechat/package*.json ./
COPY --from=base /codechat/.env ./
COPY --from=base /codechat/prisma.config.mjs ./
COPY --from=base /codechat/public ./public
COPY ./deploy_db.sh ./

RUN chmod +x ./deploy_db.sh

RUN mkdir instances


EXPOSE 8084

ENTRYPOINT [ "/bin/bash", "-c", ". ./deploy_db.sh && node ./dist/src/main" ]
